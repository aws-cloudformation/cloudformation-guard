#
# An absence predicate through a variable holding one resource. The filter walks the resource's entries:
# the Metadata and Properties maps lack `Properties.Tags`, so the predicate holds on them and they are
# selected in the resource's place; the Type string is a scalar entry, passed over, neither selected nor
# reported. A positive `exists` over the selection passes on the two maps.
#
let m = Resources.Only
let lacking = %m[ Properties.Tags !exists ]

rule entries_lacking_the_key_are_selected {
    %lacking exists
}
