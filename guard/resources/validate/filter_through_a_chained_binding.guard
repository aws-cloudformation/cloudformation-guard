#
# The filtered variable is bound to another variable, not to a path. Over a `Metadata` map with no scalar
# entry (single-map-binding-without-type-template.yaml) the filter keeps the walk and loses its selection,
# and the notice names the `let` the author wrote for the filtered name, `let b = %a`, not the query behind
# the chain. Over a `Metadata` map that holds a scalar `Type` (single-map-binding-with-password-template.yaml)
# the map is one object, the filter selects it as `%b[*][ ... ]` does, and the rule FAILs on the password
# with no notice.
#
let a = Resources.Metadata
let b = %a

rule FILTER_THROUGH_A_CHAINED_BINDING when %b[ "AWS::CloudFormation::Authentication" exists ] !empty {
  %b."AWS::CloudFormation::Authentication".*.password !exists
}
