#
# The binding of filter_through_a_key_tailed_projection.guard filtered at two sites, `ImageId exists`
# and `InstanceType exists`. Every two-properties-maps template whose instance carries both properties
# draws both sites; two-properties-maps-image-without-instance-type-template.yaml draws the first alone
# and two-properties-maps-instance-type-without-image-template.yaml the second alone. So a run over the
# templates with both followed by those two gives the two sites later-file lists that share their first
# names and their count and differ only in the last file: shortened, the two trailers would read the
# same, so each is told from the other by the first file its list lacks and the other's holds.
#
let props = Resources.*[ Type exists ].Properties
rule IMAGE_SITE when %props[ ImageId exists ] !empty {
  %props[ ImageId exists ].ImageId == "no-such-image-zzz"
}
rule INSTANCE_TYPE_SITE when %props[ InstanceType exists ] !empty {
  %props[ InstanceType exists ].InstanceType == "no-such-type-zzz"
}
