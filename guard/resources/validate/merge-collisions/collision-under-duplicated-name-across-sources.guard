#
# The held name is written twice in the earlier source: `1: a` and `1: b` are an ordinary duplicate
# pair, the last value wins, and validate reports them ("first at L:3,C:9 and again at L:3,C:15. The
# last value is the one evaluated."). The later source's `"1"` collides with that name; the earlier
# source's value stands, so its notice names `1: b`, the entry actually evaluated, as the first
# position ("first at L:3,C:15 and again at L:4,C:9. The first value is the one evaluated."). Two
# notices, in that order.
#
rule earlier_source_last_value_stands { outer."1" == "b" }
