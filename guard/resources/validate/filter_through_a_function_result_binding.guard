#
# A variable bound to a function's result -- the map `json_parse` returns -- and then filtered through
# the variable with a predicate written against that map's own keys.
#
# The parsed map holds a non-null scalar entry (`Version`) and the predicate names `Statement`, a key
# none of the map's map-valued entries holds, so the map is one object: the filter through the variable
# tests the map itself, as `%doc[*][ ... ]` does, `Statement exists` holds on it, the map is selected and
# `!empty` passes. Nothing is announced on stderr.
#
let doc = json_parse(Resources.Q.Properties.PolicyText)

rule POLICY_HAS_A_STATEMENT when %doc !empty {
    %doc[ Statement exists ] !empty
}

# The same document as a YAML map under a key, filtered the same way with the authored `[*]` before the
# filter: the answer the filter through the variable gives, PASS.
rule CONTROL_STAR_SPELLING {
    Resources.Q.Properties.Doc[*][ Statement exists ] !empty
}

# The spelling with no `[*]` is refused (FAIL, exit 19); it is kept apart from this file, in
# control_key_spelling_over_the_policy_doc.guard, so that this file exits 0.
