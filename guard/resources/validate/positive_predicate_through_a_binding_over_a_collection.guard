#
# A positive predicate through a variable holding one map with NO scalar entry, where one entry is itself
# a map carrying the key the predicate names: a collection to the slot, so the filter walks the entries
# as the literal `Resources.Only[ ... ]` does. The `Wrapper` map carries
# `Metadata."AWS::CloudFormation::Authentication"`, so the predicate holds on it and it is selected in the
# map's place; the map's own `Metadata` and `Properties` entries lack the key and are rejected. A `!exists`
# over the selection fails on the password under the selected entry, naming
# /Resources/Only/Wrapper/Metadata/AWS::CloudFormation::Authentication/WrappedCreds/password. No notice:
# the predicate does not hold on the map itself, so the map lost no selection, and an entry selected
# because it carries what the predicate asks for is the documented reading.
#
let m = Resources.Only
let carrying = %m[ Metadata."AWS::CloudFormation::Authentication" exists ]

rule the_wrapper_entry_is_selected {
    %carrying.Metadata."AWS::CloudFormation::Authentication".*.password !exists
}
