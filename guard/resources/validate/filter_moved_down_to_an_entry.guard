#
# A filter whose selection is one level DOWN from the map. `%p` holds one map with a scalar entry
# (`Name`) beside an `Inner` entry that is itself a map, and `Name` is also a key of `Inner`. The map
# is mixed, so the filter walks its entries as `Properties[ Name exists ]` would: the scalar is passed
# over, `Inner` holds the key and is selected, and nothing is refused, because the predicate holds by
# presence and not by absence. Both rules below read past the filter, so what they compare is `Inner`:
#
# - `.Tags exists`: neither the map nor `Inner` has `Tags`, so the clause fails (FAIL).
# - `.Name == 'b'`: `Inner`'s `Name` is `b`; the map's own `Name` string is a scalar the filter passes
#   over, so the clause compares `Inner`'s `b` alone and passes (PASS).
#
# No notice is written for either site: a map with a scalar entry beside a map that holds the
# predicate's key is never announced, because the walk's selection stands. A filter that could hold on
# the map by absence is refused instead, and the refusal is its answer.
#
let p = Resources.B.Properties

rule MOVED_DOWN_TAGS {
  %p[ Name exists ].Tags exists
}

rule MOVED_DOWN_NAME {
  %p[ Name exists ].Name == 'b'
}

# Over two-level-properties-template.yaml the verdicts are MOVED_DOWN_NAME PASS and MOVED_DOWN_TAGS FAIL,
# with no notice; the test over this file asserts them. The note sits after the rules so the rules' line
# numbers stay where they were.
