#
# The binding of filter_through_a_key_tailed_projection.guard, filtered at two sites: two rules gate on
# the same filter text at two lines. Each site loses its selection on a template that holds a
# `Properties` map carrying `ImageId`, so one template draws two notices, one per site. Over two such
# templates the single-line output keeps one line per site, two lines, not one per site per template
# and not one for the run.
#
let props = Resources.*[ Type exists ].Properties
rule FIRST_SITE when %props[ ImageId exists ] !empty {
  %props[ ImageId exists ].ImageId == "no-such-image-zzz"
}
rule SECOND_SITE when %props[ ImageId exists ] !empty {
  %props[ ImageId exists ].ImageId == "no-such-image-yyy"
}
