#
# A binding whose query projects in the middle and ends in a key:
# `Resources.*[ Metadata exists ].Metadata` holds one `Metadata` map per resource that has one, several
# maps. No map holds a scalar entry, and `testBasic` is not a key any of them holds itself, so the filter
# through the variable walks each map's entries. The role's map holds one sub-map, which lacks `testBasic`
# and is selected: a uniform population that draws no notice. The instance's map holds an authentication
# sub-map that carries `testBasic` and is no member, beside an init sub-map that lacks it: the predicate
# holds on the map by absence and the selection moved, so one notice names that map. The gate opens on
# the selected sub-maps and the body passes (exit 0). A predicate that names a key the map holds itself
# is one object: filter_through_a_metadata_projection_as_one_object.guard.
#
let blocks = Resources.*[ Metadata exists ].Metadata
rule FILTER_THROUGH_A_METADATA_PROJECTION when %blocks[ testBasic !exists ] !empty {
  %blocks !empty
}
