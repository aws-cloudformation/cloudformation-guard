#
# The predicate's one clause is `Properties.Tags !exists`, an absence check two keys deep: `Properties`
# resolves on the bucket and `Tags` is missing under it. The clause holds on the bucket for real. The
# bucket holds a scalar `Type` and `Properties` is not a key of any of its map-valued entries, so the
# bucket is one object: the filter through the variable tests it as a whole, as `%b[*][ ... ]` does, and
# selects the bucket itself. The gate over the selection applies. The body first compares the selection's
# own `Type`, which passes only when the bucket itself was selected, and then fails on the missing
# `Tags`. Nothing is announced on stderr.
#
let b = Resources.Bucket
let untagged = %b[ Properties.Tags !exists ]

rule BUCKET_HAS_TAGS when %untagged !empty {
  %untagged.Type == 'AWS::S3::Bucket'
  %untagged.Properties.Tags exists
}
