# `!=` against the `.*` spelling of the same right-hand side: over `Names: []` and over `Names: {}` the
# enumeration reaches nothing, the right-hand side is the empty set, every key is outside it, and the
# filter selects every key, so the assertion runs over all of them.
let names = Mappings.Allowed.Names.*

rule unequal_keys_are_two {
    Resources.*.Map[ keys != %names ] == 2
}
