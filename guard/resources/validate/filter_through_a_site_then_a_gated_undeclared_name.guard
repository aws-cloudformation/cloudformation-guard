#
# The binding and first filter site of filter_through_two_sites_one_hit_later.guard, followed by a rule
# whose `when` opens only on a template that holds `Resources.Trigger` and whose body names a variable no
# `let` declares. Over two templates that draw the site and then two-properties-maps-with-a-trigger-
# template.yaml, the first two files are evaluated whole and the third stops the run with the rules-file
# error: the single-line output owes the trailer for the site before that error is reported.
#
let props = Resources.*[ Type exists ].Properties
rule IMAGE_SITE when %props[ ImageId exists ] !empty {
  %props[ ImageId exists ].ImageId == "no-such-image-zzz"
}
rule BROKEN_BEHIND_A_TRIGGER when Resources.Trigger exists {
  %nosuch == 1
}
