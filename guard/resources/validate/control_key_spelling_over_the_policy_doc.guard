#
# The control for filter_through_a_function_result_binding.guard and
# filter_through_a_literal_map_binding.guard, over bound-map-from-a-function-or-literal-template.yaml.
#
# The policy document as a YAML map under a key, filtered after the key with no `[*]`: the filter walks
# the map's entries, the predicate names `Statement`, a key of the map itself, and the filter is refused
# (FAIL, exit 19). The refusal tells the author to write `X[*] { Key == value }` or
# `X[*].Key == value`. It sits in its own file so that each of the two subject files, whose filters
# through a variable select the one-object map, exits 0.
#
rule CONTROL_KEY_SPELLING {
    Resources.Q.Properties.Doc[ Statement exists ] !empty
}
