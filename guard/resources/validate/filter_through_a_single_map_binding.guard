#
# The structure of a published registry rule: a variable bound by a plain key path to ONE map (the
# resource whose logical id is `Metadata`), then filtered through the variable with a predicate written
# against that map's own keys.
#
# In the previous release a filter through a variable bound this way tested the bound map itself, so
# `%cfn_authentication_rule[ "AWS::CloudFormation::Authentication" exists ... ]` selected the map and
# the rule applied. A filter through a variable now walks the entries of the value the variable holds,
# exactly as the literal `Resources.Metadata[ ... ]` always did, so the predicate is tested against
# the `Type` string and the `AWS::CloudFormation::Authentication` map, matches neither, selects
# nothing, and the `when` gate makes the rule SKIP. The notice on stderr is the only output that
# records the change.
#
let cfn_authentication_rule = Resources.Metadata
let skip_cfn_authentication = %cfn_authentication_rule[
      "AWS::CloudFormation::Authentication" exists
      Metadata.cfn_nag.rules_to_suppress not exists or
      Metadata.cfn_nag.rules_to_suppress.*.id != "W1"
      Metadata.guard.SuppressedRules not exists or
      Metadata.guard.SuppressedRules.* != "CFN_AUTHENTICATION_RULE"
]

rule CFN_AUTHENTICATION_RULE when
    %cfn_authentication_rule !empty
    %skip_cfn_authentication !empty
 {
  let violation = %cfn_authentication_rule[
    "AWS::CloudFormation::Authentication".*.accessKeyId exists
    OR
    "AWS::CloudFormation::Authentication".*.password exists
    OR
    "AWS::CloudFormation::Authentication".*.secretKey exists
  ]

  %violation empty
  <<
    Violation: CFN template has sensitive credentials defined.
    Fix: Remove sensitive credentials.
  >>
}
