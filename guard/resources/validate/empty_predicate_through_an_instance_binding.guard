#
# The `empty` spelling of the absence predicate through a variable holding one resource, pinned on its
# own beside `not exists`. The resource holds a scalar `Type` and `Properties` is not a key of its
# Metadata or Properties map, so it is one object: the filter tests the resource as a whole, as
# `%m[*][ ... ]` does, `Properties.Tags empty` holds on it, and the resource is selected in its own place.
# A positive `exists` over the selection passes. Nothing is announced on stderr.
#
let m = Resources.Only
let lacking = %m[ Properties.Tags empty ]

rule entries_lacking_the_key_are_selected {
    %lacking exists
}
