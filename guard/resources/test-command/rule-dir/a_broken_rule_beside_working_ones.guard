#
# The middle rule cannot be evaluated: a filter capture belongs to the rule that made it, so `%nm` does
# not resolve here. That is a broken ruleset and the run says so.
#
# What it must not do is cost the other rules their expectations. Both of the expectations the paired spec
# states are decidable, and both were discarded — along with the whole report — because this one rule
# could not be evaluated.
#
rule producer {
    Resources[ nm | Type == 'AWS::S3::Bucket' ] !empty
}

rule reads_another_rules_capture {
    some %nm == "BucketA"
}

rule bucket_is_named_expected {
    Resources.*[ Type == 'AWS::S3::Bucket' ] {
        Properties.BucketName == 'expected'
    }
}
